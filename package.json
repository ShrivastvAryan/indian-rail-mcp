{
  "name": "indian-rail-mcp",
  "version": "0.1.1",
  "description": "Indian Railways data from official sources (NTES + IRCTC) — typed library and MCP server. Train schedules, live running status, trains between stations, live station boards, PNR status and berth-level seat availability.",
  "keywords": [
    "indian-railways",
    "irctc",
    "ntes",
    "train",
    "pnr",
    "live-train-status",
    "seat-availability",
    "train-schedule",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "mahi-v-v",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahi-v-v/indian-rail-mcp.git"
  },
  "homepage": "https://github.com/mahi-v-v/indian-rail-mcp#readme",
  "bugs": {
    "url": "https://github.com/mahi-v-v/indian-rail-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json",
    "./stdio": {
      "types": "./dist/mcp/stdio.d.ts",
      "import": "./dist/mcp/stdio.js"
    }
  },
  "bin": {
    "indian-rail-mcp": "dist/mcp/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
	"test": "tsc -p tsconfig.test.json && cp -R test/fixtures .test-dist/test/fixtures && node --test .test-dist/test/*.test.js",
    "smoke": "node --experimental-strip-types test/smoke.ts",
    "test:mcp": "npm run build && node --experimental-strip-types test/mcp-local.ts",
    "fixtures": "node test/capture-fixtures.mjs",
    "dev": "npm run build && node --experimental-strip-types dev-server.ts",
    "verify:vercel": "node test/verify-vercel-build.mjs",
    "start": "node dist/mcp/stdio.js",
    "stdio": "npm run build && node dist/mcp/stdio.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
